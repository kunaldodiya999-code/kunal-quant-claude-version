//@version=6
indicator("KTMI Uni Lite", shorttitle="KTMI Uni Lite", overlay=false, precision=2)

// KTMI Uni Lite for FYERS SMART SCRIPT (FYERS charts > Indicators > Smart Script > Write or Paste a Script).
// Made from KTMI_Uni_Lite_Compact.pine (= the locked KTMI_Uni_Lite_FINAL.pine): same inputs, same TRIX/EMA
// calculations, same signal conditions, plots, fills, arrows and alerts. Two differences, for FYERS:
//   1. getSource picks the price with a chain of "? :" instead of "switch" (the FYERS reference does not list it).
//   2. Trigger defaults = the owner's TradingView chart (24 Oct 2026): Momentum Buy / Sell EMPTY (off),
//      Long Buy 0.5, Short Buy 0.5  ->  Long Momentum Buy = BUY CALL, Short Momentum Buy = BUY PUT.
// Two extra alerts name the trade: "KTMI BUY CALL" and "KTMI BUY PUT".

DISPLAY_MULTIPLIER = 100.0

// ---- GENERAL SETTINGS
gG = "GENERAL SETTINGS"
showLevels  = input.bool(true, "Show Level Lines", group=gG)
centerLevel = input.float(0.0, "Center Line", step=0.1, group=gG)
upperLevel  = input.float(0.5, "Upper Level", step=0.1, group=gG)
lowerLevel  = input.float(-0.5, "Lower Level", step=0.1, group=gG)
levelColor  = input.color(color.rgb(121, 123, 133), "Level Color", group=gG)

// ---- 1. MOMENTUM SETTINGS
gM = "1. MOMENTUM SETTINGS"
momSource       = input.string("Close", "Input Source", options=["Close", "Open", "High", "Low", "HL2", "HLC3", "OHLC4"], group=gM)
momSpeedLength  = input.int(5, "Speed Length", minval=1, group=gM)
momSignalLength = input.int(9, "Signal Length", minval=1, group=gM)
momSmoothing    = input.string("EMA", "Smoothing Type", options=["EMA"], group=gM)
momEnable       = input.bool(true, "Enable Momentum", group=gM)
momCalculation  = input.string("TRIX", "Calculation Method", options=["TRIX"], group=gM)

// ---- 2. LONG MOMENTUM SETTINGS
gL = "2. LONG MOMENTUM SETTINGS"
longSource       = input.string("High", "Input Source", options=["Close", "Open", "High", "Low", "HL2", "HLC3", "OHLC4"], group=gL)
longSpeedLength  = input.int(5, "Speed Length", minval=1, group=gL)
longSignalLength = input.int(9, "Signal Length", minval=1, group=gL)
longSmoothing    = input.string("EMA", "Smoothing Type", options=["EMA"], group=gL)
longEnable       = input.bool(true, "Enable Long Momentum", group=gL)
longCalculation  = input.string("TRIX", "Calculation Method", options=["TRIX"], group=gL)

// ---- 3. SHORT MOMENTUM SETTINGS
gS = "3. SHORT MOMENTUM SETTINGS"
shortSource       = input.string("Low", "Input Source", options=["Close", "Open", "High", "Low", "HL2", "HLC3", "OHLC4"], group=gS)
shortSpeedLength  = input.int(5, "Speed Length", minval=1, group=gS)
shortSignalLength = input.int(9, "Signal Length", minval=1, group=gS)
shortSmoothing    = input.string("EMA", "Smoothing Type", options=["EMA"], group=gS)
shortEnable       = input.bool(true, "Enable Short Momentum", group=gS)
shortCalculation  = input.string("TRIX", "Calculation Method", options=["TRIX"], group=gS)

// ---- ARROW / SIGNAL TRIGGERS (empty box = arrow off)
gT = "ARROW / SIGNAL TRIGGERS"
momBuyTrigger    = str.tonumber(input.string("", "Momentum Buy Trigger", group=gT))
momSellTrigger   = str.tonumber(input.string("", "Momentum Sell Trigger", group=gT))
longBuyTrigger   = str.tonumber(input.string("0.5", "Long Buy Trigger", group=gT))
longSellTrigger  = str.tonumber(input.string("", "Long Sell Trigger", group=gT))
shortBuyTrigger  = str.tonumber(input.string("0.5", "Short Buy Trigger", group=gT))
shortSellTrigger = str.tonumber(input.string("", "Short Sell Trigger", group=gT))

// ---- EXTRAS / SCALE SETTINGS
showFill        = input.bool(true, "Fill Speed / Signal", group="EXTRAS")
oversoldScale   = input.float(-3.0, "Oversold Scale", step=0.1, group="SCALE SETTINGS")
overboughtScale = input.float(3.0, "Overbought Scale", step=0.1, group="SCALE SETTINGS")

// ---- CALCULATIONS
getSource(string name) =>
    name == "Open" ? open : name == "High" ? high : name == "Low" ? low : name == "HL2" ? hl2 : name == "HLC3" ? hlc3 : name == "OHLC4" ? ohlc4 : close

// TRIX = % change of a triple EMA. Speed/Signal are scaled x100 for display.
// invert=true flips the raw TRIX before the Signal EMA (Short Momentum).
ktmiModule(string src, int speedLen, int signalLen, bool invert) =>
    e3 = ta.ema(ta.ema(ta.ema(getSource(src), speedLen), speedLen), speedLen)
    float raw = not na(e3[1]) and e3[1] != 0.0 ? 100.0 * (e3 - e3[1]) / e3[1] : na
    raw := invert ? -raw : raw
    [raw * DISPLAY_MULTIPLIER, ta.ema(raw, signalLen) * DISPLAY_MULTIPLIER]

[momSpeed, momSignal]     = ktmiModule(momSource, momSpeedLength, momSignalLength, false)
[longSpeed, longSignal]   = ktmiModule(longSource, longSpeedLength, longSignalLength, false)
[shortSpeed, shortSignal] = ktmiModule(shortSource, shortSpeedLength, shortSignalLength, true)

// ---- SIGNAL ENGINE: cross the trigger AND agree with Signal AND correct side of zero
buyCond(bool on, float trig, float spd, float sig) => on and not na(trig) and ta.crossover(spd, trig) and spd > sig and spd > 0
sellCond(bool on, float trig, float spd, float sig) => on and not na(trig) and ta.crossunder(spd, trig) and spd < sig and spd < 0

momBuy    = buyCond(momEnable, momBuyTrigger, momSpeed, momSignal)
momSell   = sellCond(momEnable, momSellTrigger, momSpeed, momSignal)
longBuy   = buyCond(longEnable, longBuyTrigger, longSpeed, longSignal)
longSell  = sellCond(longEnable, longSellTrigger, longSpeed, longSignal)
shortBuy  = buyCond(shortEnable, shortBuyTrigger, shortSpeed, shortSignal)
shortSell = sellCond(shortEnable, shortSellTrigger, shortSpeed, shortSignal)

// ---- LEVEL AND SCALE LINES
lvlDisplay = showLevels ? display.all : display.none
hline(centerLevel, "Center Line", color=levelColor, linestyle=hline.style_solid, linewidth=2, editable=true, display=lvlDisplay)
hline(upperLevel, "Upper Level", color=levelColor, linestyle=hline.style_dashed, linewidth=2, editable=true, display=lvlDisplay)
hline(lowerLevel, "Lower Level", color=levelColor, linestyle=hline.style_dashed, linewidth=2, editable=true, display=lvlDisplay)
hline(overboughtScale, "Overbought Scale", color=color.rgb(112, 48, 160), linestyle=hline.style_solid, linewidth=1, editable=true)
hline(oversoldScale, "Oversold Scale", color=color.rgb(112, 48, 160), linestyle=hline.style_solid, linewidth=1, editable=true)
pOverboughtScale = plot(overboughtScale, "Overbought Fill Boundary", color=na, linewidth=1, display=display.none, editable=false)
pOversoldScale = plot(oversoldScale, "Oversold Fill Boundary", color=na, linewidth=1, display=display.none, editable=false)

// ---- SPEED / SIGNAL PLOTS AND FILLS
cMom   = color.rgb(254, 154, 42)
cLong  = color.rgb(0, 154, 130)
cShort = color.rgb(244, 9, 99)
pMomSpeed    = plot(momEnable ? momSpeed : na, "Momentum Speed", color=cMom, linewidth=2, style=plot.style_line, editable=true)
pMomSignal   = plot(momEnable ? momSignal : na, "Momentum Signal", color=color.rgb(249, 239, 84), linewidth=2, style=plot.style_line, editable=true)
pLongSpeed   = plot(longEnable ? longSpeed : na, "Long Momentum Speed", color=cLong, linewidth=2, style=plot.style_line, editable=true)
pLongSignal  = plot(longEnable ? longSignal : na, "Long Momentum Signal", color=color.rgb(56, 180, 91), linewidth=2, style=plot.style_line, editable=true)
pShortSpeed  = plot(shortEnable ? shortSpeed : na, "Short Momentum Speed", color=cShort, linewidth=2, style=plot.style_line, editable=true)
pShortSignal = plot(shortEnable ? shortSignal : na, "Short Momentum Signal", color=color.rgb(244, 48, 72), linewidth=2, style=plot.style_line, editable=true)

fill(pMomSpeed, pMomSignal, color=showFill and momEnable ? color.new(cMom, 88) : na, title="Momentum Fill", editable=true)
fill(pLongSpeed, pLongSignal, color=showFill and longEnable ? color.new(cLong, 88) : na, title="Long Fill", editable=true)
fill(pShortSpeed, pShortSignal, color=showFill and shortEnable ? color.new(cShort, 88) : na, title="Short Fill", editable=true)

// Overbought/oversold fills switch on when Speed reaches the scale exactly (>= / <=).
fill(pMomSpeed, pOverboughtScale, color=momEnable and momSpeed >= overboughtScale ? color.new(color.green, 82) : na, title="Momentum Overbought Fill", editable=true)
fill(pMomSpeed, pOversoldScale, color=momEnable and momSpeed <= oversoldScale ? color.new(color.red, 82) : na, title="Momentum Oversold Fill", editable=true)
fill(pLongSpeed, pOverboughtScale, color=longEnable and longSpeed >= overboughtScale ? color.new(color.green, 82) : na, title="Long Overbought Fill", editable=true)
fill(pLongSpeed, pOversoldScale, color=longEnable and longSpeed <= oversoldScale ? color.new(color.red, 82) : na, title="Long Oversold Fill", editable=true)
fill(pShortSpeed, pOverboughtScale, color=shortEnable and shortSpeed >= overboughtScale ? color.new(color.green, 82) : na, title="Short Overbought Fill", editable=true)
fill(pShortSpeed, pOversoldScale, color=shortEnable and shortSpeed <= oversoldScale ? color.new(color.red, 82) : na, title="Short Oversold Fill", editable=true)

// ---- SIGNAL ARROWS AND ALERTS
plotshape(momBuy, title="Momentum Buy", style=shape.triangleup, location=location.bottom, color=color.rgb(23, 140, 86), size=size.tiny, editable=true)
plotshape(momSell, title="Momentum Sell", style=shape.triangledown, location=location.top, color=color.rgb(145, 47, 59), size=size.tiny, editable=true)
plotshape(longBuy, title="Long Momentum Buy", style=shape.triangleup, location=location.bottom, color=color.rgb(0, 154, 130), size=size.tiny, editable=true)
plotshape(longSell, title="Long Momentum Sell", style=shape.triangledown, location=location.top, color=color.rgb(150, 100, 44), size=size.tiny, editable=true)
plotshape(shortBuy, title="Short Momentum Buy", style=shape.triangleup, location=location.bottom, color=color.rgb(244, 48, 72), size=size.tiny, editable=true)
plotshape(shortSell, title="Short Momentum Sell", style=shape.triangledown, location=location.top, color=color.rgb(140, 34, 146), size=size.tiny, editable=true)

alertcondition(momBuy, title="Momentum Buy", message="KTMI Uni Lite: Momentum Buy trigger crossed")
alertcondition(momSell, title="Momentum Sell", message="KTMI Uni Lite: Momentum Sell trigger crossed")
alertcondition(longBuy, title="Long Momentum Buy", message="KTMI Uni Lite: Long Momentum Buy trigger crossed")
alertcondition(longSell, title="Long Momentum Sell", message="KTMI Uni Lite: Long Momentum Sell trigger crossed")
alertcondition(shortBuy, title="Short Momentum Buy", message="KTMI Uni Lite: Short Momentum Buy trigger crossed")
alertcondition(shortSell, title="Short Momentum Sell", message="KTMI Uni Lite: Short Momentum Sell trigger crossed")

alertcondition(longBuy, title="KTMI BUY CALL", message="KTMI BUY CALL {{ticker}} {{interval}} close {{close}}")
alertcondition(shortBuy, title="KTMI BUY PUT", message="KTMI BUY PUT {{ticker}} {{interval}} close {{close}}")
